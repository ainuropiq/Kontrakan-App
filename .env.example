# =====================================================
# .env.example — Kontrakan Manager
# Salin file ini menjadi .env lalu isi nilainya
# Di Railway: isi di Settings > Variables
# =====================================================

# Database PostgreSQL
# Railway akan mengisi ini otomatis saat tambah plugin PostgreSQL
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Environment
NODE_ENV=production

# Port (Railway isi otomatis, tidak perlu diubah)
PORT=3000
